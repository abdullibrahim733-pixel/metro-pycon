# Copy this file to .env and add your own private OpenRouter key.
# Never commit or share .env.
OPENROUTER_API_KEY=sk-or-v1-PASTE-YOUR-PRIVATE-KEY

# Router alias or any currently available free variant ending in :free
OPENROUTER_MODEL=openrouter/free

# Teaching threshold in Tanzanian shillings (change to 100000 during the lab)
METRO_HIGH_VALUE_TZS=250000
